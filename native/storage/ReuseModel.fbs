  namespace fastbotx;

table ActivityTimes {
  activity:string;
  times:int;
}

// action is the key so vectors of ReuseEntry can be stored as sorted tables
table ReuseEntry {
  action:ulong (key);
  targets:[ActivityTimes];
  quality:float = 0.0; // Q-value (optional, default 0.0)
}

table ReuseModel {
  model:[ReuseEntry];
}

root_type ReuseModel;

