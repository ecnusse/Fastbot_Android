/**
* @author Jianqiang Guo
*/
// IDL for reuse model

namespace fastbotx;

table ActivityTimes {
    activity: string;
    times: int;
}

table ActionCounts {
    action: ulong;
    times: int;
}

// PathTemplate stores a sequence of up to 6 action hashes and a reliability (double) per step.
// Using vectors keeps the schema flexible; consumer code may expect fixed-length arrays of length 6.
table PathTemplate {
    // sequence of action hashes (ulong), index 0 start .. index 5 end (may be shorter)
    sequence: [ulong];
    // per-step reliability values in range [0,1]
    reliability: [double];
}

table PreconditionPage {
    hashcode: ulong;
    score: double;
    action_counts: [ActionCounts];
    // optional templates persisted in flatbuffer for compatibility; may be absent in older files
    templates: [PathTemplate];
}

table ReuseEntry {
    action: ulong (key);
    targets: [ActivityTimes];
}

table ReuseModel {
    model: [ReuseEntry];
    precondition_pages: [PreconditionPage];
}

root_type ReuseModel;